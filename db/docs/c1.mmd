    department ||--o{ user : "소속"
    department ||--o{ course : "개설 학과"
    department ||--o{ room : "전용 학과"
    time_grid ||--o{ time_slot : "칸 구성"
    time_grid ||--o{ term : "사용"
    term ||--o{ course : "개설"
    term ||--o{ phase_log : "단계 변경 기록"
    term ||--o{ rule_config : "규칙 설정"
    user ||--o{ course : "담당 교수(기본)"
    course ||--o{ course_section : "분반"
    user ||--o{ course_section : "분반 담당 교수"
    building ||--o{ room : "포함"
    department {
        int id PK
        text name
        text college "단과대"
    }
    user {
        int id PK
        text role "TA or PROF"
        text name
        text email
        text phone
        int department_id FK
        text password_hash
        int hire_year "임용 연도(연차), 동점 순서용, 비어도 됨"
    }
    time_grid {
        int id PK
        text name "시간 격자 한 벌"
    }
    time_slot {
        int id PK
        int grid_id FK
        text day
        int period_no
        text start_time
        text end_time
        text label
    }
    term {
        int id PK
        int year
        text semester
        int grid_id FK
        text phase "COLLECTING ROUND1 ROUND2 ROUND3 FINAL 지금 단계"
        text phase_changed_at
    }
    phase_log {
        int id PK
        int term_id FK
        text from_phase
        text to_phase
        int changed_by FK
        text changed_at
    }
    building {
        int id PK
        text name
    }
    room {
        int id PK
        int building_id FK
        text room_no
        int capacity
        int is_lab
        int reserved_department_id FK
    }
    course {
        int id PK
        int term_id FK
        int department_id FK
        int professor_id FK "기본 담당 교수"
        text code
        text name
        text category "전공필수 등"
        text target_year
        int session_count
        int slots_per_session
    }
    course_section {
        int course_id PK
        int section_no PK
        int professor_id FK "분반별 담당 교수"
        int enrollment "분반 수강 인원 (교수가 정함)"
    }
    rule_config {
        int id PK
        int term_id FK
        text rule_key
        text kind "HARD or SOFT"
        real weight
        int enabled
    }
