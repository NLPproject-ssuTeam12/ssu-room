    term { int id PK }
    user { int id PK }
    course { int id PK }
    time_slot { int id PK }
    building { int id PK }
    round {
        int id PK
        int term_id FK
        int round_no "1 2 3"
        text deadline_at "회신 기한"
        text status
    }
    round_invite {
        int round_id PK
        int professor_id PK
        text status "미회신 회신 기한초과"
        text responded_at
    }
    course_response {
        int id PK
        int round_id FK
        int course_id FK
        int section_no "분반마다 응답 (11/25)"
        int professor_id FK "그 분반 담당 교수"
        int lab_requirement "1 쓴다 0 안 쓴다 필수 입력"
        text single_day_pref "MUST NONE 주1회 연강(분반 내)"
    }
    pair_request {
        int id PK
        int round_id FK
        int course_id FK
        int professor_id FK
        text mode "BACK_TO_BACK CROSS (상관없음 = 행 없음)"
    }
    pair_request_section {
        int request_id PK
        int seq PK "교수가 적은 순서, 솔버는 앞 두 분반만"
        int section_no
    }
    response_slot {
        int response_id PK
        int slot_id PK
        text kind "PREFER BLOCK 안 칠하면 상관없음"
    }
    other_request {
        int id PK
        int response_id FK "희망 입력 기타 (응답당 하나)"
        int message_id FK "조율 답장 기타 (답장당 하나)"
        text body "교수가 쓴 자연어 원문"
        text status "PENDING CONFIRMED 조교 확인함"
        int confirmed_by FK
        text confirmed_at
        text ta_memo
    }
    request_item {
        int id PK
        int response_id FK
        int other_request_id FK "조교가 기타 요청을 보고 만든 경우"
        text type "SECTION_PAIR 등 (SECTION_COUNT는 솔버가 안 읽음)"
        int value_int
        text value_text
        text params_json
        text source "FORM TA"
        int created_by FK
    }
    chapel_slot {
        int term_id PK
        text target_year PK "그 학년 전공필수는 이 칸 금지"
        int slot_id PK
    }
    professor_building_pref {
        int professor_id PK
        int building_id FK "교수당 하나, 그 밖은 벌점"
    }
