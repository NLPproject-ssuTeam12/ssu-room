    round { int id PK }
    course { int id PK }
    room { int id PK }
    user { int id PK }
    time_slot { int id PK }
    solver_run {
        int id PK
        int round_id FK
        text status
        real objective_value
        text weights_json
    }
    timetable {
        int id PK
        int solver_run_id FK
        int parent_id FK "고친 원본"
        int created_by FK "NULL이면 시스템"
        text kind "DRAFT TA_EDIT FINAL"
        text reason "이 버전을 만든 이유 (조교 수정 사유 등)"
    }
    timetable_section {
        int timetable_id PK
        int course_id PK
        int section_no PK
        int planned_enrollment
        text status "DONE COORD MANUAL"
        int locked "1 고정"
    }
    assignment {
        int timetable_id PK
        int course_id PK
        int section_no PK
        int session_no PK
        int slot_id PK
        int room_id FK "같은 칸 같은 방 불가"
    }
    proposal {
        int id PK
        int timetable_id FK
        int course_id FK
        int section_no "어느 분반인지"
        text reason
        text status "OPEN SENT PROPOSED RESOLVED KEPT NEXT OFFLINE HOLD NO_OPTION"
        int prev_proposal_id FK "이전 차수 안건"
        text target_kind "UNPLACED MISMATCH PARTIAL 조율 대상 종류"
    }
    proposal_option {
        int id PK
        int proposal_id FK
        int option_no "1 2 3"
        text source "SOLVER or TA"
    }
    proposal_option_slot {
        int option_id PK
        int section_no PK
        int session_no PK
        int slot_id PK
        int room_id FK
    }
    message {
        int id PK
        int proposal_id FK
        int sender_id FK
        int receiver_id FK
        text kind "NOTICE REMINDER ALTERNATIVE REPLY"
        text channel "APP EMAIL SMS"
        text body
        int reply_to_id FK "답하는 조율 메시지"
    }
    reply_interpretation {
        int message_id PK
        text label "ACCEPT CONDITIONAL REJECT UNCLEAR"
        int chosen_option_id FK
        text extracted_json
        text ta_action "CONFIRM EDIT KEEP OFFLINE"
    }
    reply_choice {
        int message_id PK
        text choice PK "A B C ETC 하나 이상"
        int option_id FK
    }
